# Secret used to sign session cookies (change in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: your real inference server. If unset, the API returns mock output.
# langgenie forwards multipart audio to:
#   ${INFERENCE_URL}/odia-odia      (Odia speech -> Odia text)
#   ${INFERENCE_URL}/odia-english   (Odia speech -> English text)
INFERENCE_URL=
INFERENCE_API_KEY=
